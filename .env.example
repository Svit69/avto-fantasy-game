TELEGRAM_BOT_TOKEN=
TELEGRAM_WEB_APP_URL=https://fantasy.example.ru
TELEGRAM_WEBHOOK_URL=https://fantasy.example.ru/api/telegram-webhook
USER_DATABASE_PATH=storage/users.json
PLAYER_DATABASE_PATH=storage/players.json
ROSTER_DATABASE_PATH=storage/rosters.json
STORAGE_DRIVER=json
DATABASE_URL=postgresql://avto_fantasy:change_me@localhost:5432/avto_fantasy
TELEGRAM_ADMIN_IDS=
TELEGRAM_API_TIMEOUT_MS=15000
PORT=3000
HOST=127.0.0.1
# Set true only behind a trusted proxy with direct Node access blocked.
TRUST_PROXY=false
OPERATIONS_MONITOR_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
API_READ_CONCURRENCY=8
API_READ_QUEUE_SIZE=32
# Serial writes for JSON; set 2 when using PostgreSQL.
API_WRITE_CONCURRENCY=1
API_WRITE_QUEUE_SIZE=8
API_READ_PER_MINUTE=180
API_WRITE_PER_MINUTE=30
API_ANONYMOUS_READ_PER_MINUTE=3000
API_ANONYMOUS_WRITE_PER_MINUTE=120
HEAVY_TASK_QUEUE_SIZE=4
PRICE_REVIEW_CACHE_MS=90000
PG_POOL_MAX=4
PG_CONNECTION_TIMEOUT_MS=3000
PG_STATEMENT_TIMEOUT_MS=30000
OPERATIONS_MONITOR_ENABLED=true
MONITOR_VHL_ENABLED=true
# Disabled by default. Server-side GET work only; never blocks or restarts.
MONITOR_API_P95_WARN_MS=0
MONITOR_ALERT_COOLDOWN_MS=900000
# Configure on a separate host for external monitoring, not on the app VPS.
HEALTH_PROBE_URL=
